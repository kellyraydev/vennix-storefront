# ─────────────────────────────────────────────────────────────────────────────
# Vennix storefront — environment template
#
# Copy to `.env` (or `.env.local`), or export in your shell / host environment.
# `.env` and `.env.local` are git-ignored; NO secrets belong in the repo.
# The real process environment always wins over these files, so a host can
# override anything without editing a file.
#
# Leave SHOPIFY_STORE_DOMAIN unset to run in DEMO MODE: the storefront boots
# an in-process mock Storefront-API gateway serving the committed fixture
# catalog (data/fixtures/shopify-store.json) and labels itself in the UI.
# Demo mode is impossible when NODE_ENV=production unless VENNIX_ALLOW_DEMO=1.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify connection (production) ──────────────────────────────────────────
# Your store's myshopify domain, e.g. your-store.myshopify.com
# Create a custom app (or use an existing one) and grant its Storefront API
# integration these access scopes:
#   unauthenticated_read_product_listings
#   unauthenticated_read_product_inventory
#   unauthenticated_write_checkouts
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version. The current stable release.
# Supported until 2027-07-16 — see https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2026-07

# Optional: the store's primary domain if it differs from the myshopify
# domain (used for canonical links to the Shopify-hosted /account pages)
SHOPIFY_PRIMARY_DOMAIN=

# Optional: explicit customer-account URL (defaults to https://<primary domain>/account)
SHOPIFY_ACCOUNT_URL=

# Optional: extra hosts allowed to receive the checkout handoff, comma
# separated. Everything on *.myshopify.com, *.shopify.com and your own
# store domains is allowed already.
SHOPIFY_CHECKOUT_HOSTS=

# Optional: catalog cache TTL in milliseconds (default 15000).
# Prices and stock are always re-checked by Shopify at cart and checkout.
SHOPIFY_CACHE_TTL_MS=15000

# Optional: per-request timeout for Storefront API calls, ms (default 9000)
SHOPIFY_TIMEOUT_MS=9000

# Set to 1 to skip the boot-time connection preflight (not recommended)
VENNIX_SKIP_PREFLIGHT=

# ── Storefront server ────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Set to production behind TLS: makes cookies Secure, enables HSTS, and
# refuses to boot in demo mode without VENNIX_ALLOW_DEMO=1
NODE_ENV=development

# Public overrides for the presentation settings in config/storefront.json
PUBLIC_SITE_DOMAIN=
PUBLIC_SUPPORT_EMAIL=

# ── Deployment / proxy ───────────────────────────────────────────────────────
# Whether to trust this deployment's reverse proxy for forwarded headers
# (x-real-ip, the rightmost X-Forwarded-For hop, X-Forwarded-Proto).
#   1 / true   trust it — rate limiting keys per visitor, cookies go Secure on
#              X-Forwarded-Proto: https
#   0 / false  never trust it — even on a platform proxy (every visitor then
#              shares ONE rate-limit bucket; doctor errors on this)
#   unset      auto: trusted on platform proxies (Vercel, Render, Fly.io,
#              Railway), direct socket otherwise
TRUST_PROXY=

# Where non-commerce captures (newsletter, contact, reviews, back-in-stock)
# are written. Must be writable AND persistent if you want to keep them —
# serverless filesystems are read-only, and a capture that cannot be written
# is answered to the shopper but dropped. /healthz exposes leads.writable and
# leads.writeFailures; doctor errors on an unwritable sink in production.
LEADS_DIR=

# Serverless only: minimum ms between Shopify preflight retries after a failed
# boot (default 5000) — prevents a request-driven retry storm during an outage.
VENNIX_INIT_RETRY_MS=

# Allow the fixture catalog in a NODE_ENV=production deploy (demo/staging only)
VENNIX_ALLOW_DEMO=

# ── Cookies ──────────────────────────────────────────────────────────────────
# auto (default) | on | off — with the __Host- prefix a cookie cannot be set or
# shadowed by any subdomain. It requires Secure + Path=/, so `auto` only enables
# it when every response is TLS (NODE_ENV=production). Turn it off if you serve
# the site over plain http in production.
COOKIE_HOST_PREFIX=auto
# Escape hatch for a plain-http production host: drops the Secure flag and the
# __Host- prefix. Only for a proxy you control that terminates TLS elsewhere.
VENNIX_FORCE_INSECURE_COOKIES=

# ── Security headers ─────────────────────────────────────────────────────────
# enforce (default) | report-only | off
CSP_MODE=enforce
# Optional: where the browser sends CSP violation reports
CSP_REPORT_URI=
# Tighten the policy; defaults cover 'self' + Shopify's CDN
# CSP_IMG_SRC="'self' data: https:"
# CSP_SCRIPT_SRC=   (leave unset — the nonce is added automatically)
# CSP_CONNECT_SRC="'self'"
# Set HSTS_PRELOAD=1 only when you are ready to submit the domain for preload
HSTS_PRELOAD=

# ── Performance ──────────────────────────────────────────────────────────────
# Set to 1 to disable brotli/gzip response compression
COMPRESSION_OFF=

# ── Live verification ────────────────────────────────────────────────────────
# A real discount code from your store, so `npm run verify:live` can prove a
# valid code prices the cart (invalid codes are proven refused either way)
VENNIX_LIVE_DISCOUNT_CODE=
